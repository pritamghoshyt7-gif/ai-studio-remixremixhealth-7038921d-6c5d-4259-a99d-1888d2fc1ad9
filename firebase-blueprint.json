{
  "entities": {
    "CollectionCentre": {
      "title": "CollectionCentre",
      "description": "Diagnostic sample collection centre profile and location",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "centreCode": { "type": "string" },
        "ownerName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "email": { "type": "string" },
        "fullAddress": { "type": "string" },
        "pinCode": { "type": "string" },
        "state": { "type": "string" },
        "district": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "openingTime": { "type": "string" },
        "closingTime": { "type": "string" },
        "assignedCollectorId": { "type": "string" },
        "assignedCollectorName": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "centreCode", "status"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Patient demographic and diagnostic registration details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "mobileNumber": { "type": "string" },
        "address": { "type": "string" },
        "centreId": { "type": "string" },
        "centreName": { "type": "string" },
        "registrationDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "centreId"]
    },
    "Sample": {
      "title": "Sample",
      "description": "Biological diagnostic sample record with barcode and logistics status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sampleId": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "centreId": { "type": "string" },
        "centreName": { "type": "string" },
        "testName": { "type": "string" },
        "sampleType": { "type": "string" },
        "barcodeNumber": { "type": "string" },
        "qrCode": { "type": "string" },
        "collectionDateTime": { "type": "string" },
        "collectorName": { "type": "string" },
        "collectorId": { "type": "string" },
        "destinationLab": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "REGISTERED",
            "COLLECTED",
            "PICKUP REQUESTED",
            "PICKED UP",
            "IN TRANSIT",
            "ARRIVED AT LAB",
            "RECEIVED AND VERIFIED",
            "PROCESSING",
            "COMPLETED",
            "DELIVERED",
            "REJECTED",
            "CANCELLED",
            "ON HOLD"
          ]
        },
        "remarks": { "type": "string" },
        "temperature": { "type": "string" },
        "containerType": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "sampleId", "patientId", "centreId", "status"]
    },
    "Collector": {
      "title": "Collector",
      "description": "Logistics runner / sample field phlebotomist",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "collectorId": { "type": "string" },
        "name": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "employeeId": { "type": "string" },
        "assignedCentres": { "type": "array" },
        "assignedGpsDeviceId": { "type": "string" },
        "assignedVehicle": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "ON_DUTY", "OFF_DUTY"] },
        "currentLatitude": { "type": "number" },
        "currentLongitude": { "type": "number" },
        "lastLocationUpdate": { "type": "string" },
        "batteryLevel": { "type": "number" },
        "speedKmh": { "type": "number" },
        "isOnline": { "type": "boolean" }
      },
      "required": ["id", "name", "mobileNumber", "status"]
    },
    "GpsDevice": {
      "title": "GpsDevice",
      "description": "Hardware GPRS GPS unit mounted in transit vehicles or cold bags",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "imei": { "type": "string" },
        "deviceName": { "type": "string" },
        "simNumber": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "assignedCollectorId": { "type": "string" },
        "assignedCollectorName": { "type": "string" },
        "deviceProtocol": { "type": "string" },
        "serverConnectionStatus": { "type": "string", "enum": ["ONLINE", "OFFLINE", "STANDBY"] },
        "lastGpsUpdate": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "speed": { "type": "number" },
        "batteryStatus": { "type": "string" },
        "gpsSignalStatus": { "type": "string" }
      },
      "required": ["id", "imei", "deviceName", "vehicleNumber"]
    },
    "LogisticsTrip": {
      "title": "LogisticsTrip",
      "description": "Pickup batch and dispatch journey",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripCode": { "type": "string" },
        "centreId": { "type": "string" },
        "centreName": { "type": "string" },
        "collectorId": { "type": "string" },
        "collectorName": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "destinationLab": { "type": "string" },
        "pickupTime": { "type": "string" },
        "expectedDeliveryTime": { "type": "string" },
        "sampleCount": { "type": "number" },
        "sampleIds": { "type": "array" },
        "status": { "type": "string", "enum": ["REQUESTED", "ASSIGNED", "PICKED_UP", "IN_TRANSIT", "ARRIVED", "DELIVERED", "DELAYED"] },
        "delayReason": { "type": "string" }
      },
      "required": ["id", "centreId", "status"]
    },
    "LabReceipt": {
      "title": "LabReceipt",
      "description": "Central laboratory sample receiving record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "manifestNumber": { "type": "string" },
        "receivedAt": { "type": "string" },
        "receiverName": { "type": "string" },
        "receiverUserId": { "type": "string" },
        "scannedSampleIds": { "type": "array" },
        "verifiedCount": { "type": "number" },
        "missingCount": { "type": "number" },
        "damagedCount": { "type": "number" },
        "rejectionNotes": { "type": "string" }
      },
      "required": ["id", "manifestNumber", "receivedAt"]
    },
    "BillingRecord": {
      "title": "BillingRecord",
      "description": "Centre-wise billing ledger and payments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "centreId": { "type": "string" },
        "centreName": { "type": "string" },
        "period": { "type": "string" },
        "sampleCount": { "type": "number" },
        "sampleCharges": { "type": "number" },
        "pickupCharges": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "balanceDue": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["PAID", "PARTIAL", "DUE"] }
      },
      "required": ["id", "centreId", "totalAmount"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System event and status mutation audit trace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "performedBy": { "type": "string" },
        "performedByName": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "action", "timestamp"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Laboratory profile, prefixes, and WhatsApp templates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "labName": { "type": "string" },
        "labAddress": { "type": "string" },
        "contactNumber": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "sampleIdPrefix": { "type": "string" },
        "centreIdPrefix": { "type": "string" },
        "barcodePrefix": { "type": "string" },
        "gpsServerHost": { "type": "string" },
        "gpsServerPort": { "type": "number" },
        "whatsappEnglishTemplate": { "type": "string" },
        "whatsappBengaliTemplate": { "type": "string" }
      },
      "required": ["id", "labName"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and role-based permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": {
          "type": "string",
          "enum": [
            "Super Admin",
            "Admin",
            "Centre Operator",
            "Collector",
            "Lab Receiver",
            "Accounts Manager"
          ]
        },
        "centreId": { "type": "string" },
        "assignedCollectorId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    }
  },
  "firestore": {
    "/collectionCentres/{centreId}": {
      "schema": "CollectionCentre",
      "description": "Registered collection centres"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Patients registered at collection centres"
    },
    "/samples/{sampleId}": {
      "schema": "Sample",
      "description": "Diagnostic biological samples and tracking data"
    },
    "/collectors/{collectorId}": {
      "schema": "Collector",
      "description": "Phlebotomist and field sample runners"
    },
    "/gpsDevices/{deviceId}": {
      "schema": "GpsDevice",
      "description": "GPRS GPS Hardware telemetry devices"
    },
    "/logisticsTrips/{tripId}": {
      "schema": "LogisticsTrip",
      "description": "Logistics transit and dispatch batches"
    },
    "/labReceipts/{receiptId}": {
      "schema": "LabReceipt",
      "description": "Central laboratory receiving records"
    },
    "/billingRecords/{billId}": {
      "schema": "BillingRecord",
      "description": "Billing balances and statements"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable security and action audit logs"
    },
    "/systemSettings/{settingId}": {
      "schema": "SystemSettings",
      "description": "System wide configurations"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Application users and authorization roles"
    }
  }
}
